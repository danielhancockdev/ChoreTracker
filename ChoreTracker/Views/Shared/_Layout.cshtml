@* _Layout.cshtml shared cshtml *@

<!DOCTYPE html>

<html lang="en">  

    @* Shared - Page Meta Data *@

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ChoreTracker</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ChoreTracker.styles.css" asp-append-version="true" />
</head>

<body>

    @* Shared - Header Content *@

    <header>
        <nav class="navbar">

            <div class="navbar-container">

                <a class="navbar-brand" 
                asp-area=""
                asp-controller="Home"
                asp-action="Index">
                ChoreTracker
                </a>

                <div class="navbar-links">
                    <a class="navbar-brand" 
                    asp-area=""
                    asp-controller="Home"
                    asp-action="Index">
                    Home
                </a>
                </div>

                <div class="navbar-links">
                    <a class="navbar-brand"
                    asp-area=""
                    asp-controller="Chores"
                    asp-action="Index">
                    Chores
                    </a>

                </div>
            </div>
        </nav>
    
    </header>

    @* Shared - Main Page Content *@

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* Shared - Footer Content *@

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - ChoreTracker - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
