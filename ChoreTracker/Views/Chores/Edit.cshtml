@model ChoreTracker.ViewModels.EditChoreViewModel
<form asp-controller="Chores" asp-action="Edit" method="post">
    <input type "hidden" name="Id" value="@Model.Id"
    <input type="text" name="Name" value="@Model.Name" />
    <input type="text" name="Description" value="@Model.Description" />
    <input type="date" name="DueDate" value="@Model.DueDate" />
    <input type="number" name="RecurrenceDays" value="@Model.RecurrenceDays" />
    <button type="submit">Edit</button>
</form>